# ══════════════════════════════════════════════════════════════════
# AI-Powered Excel Data Intelligence Platform — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ══════════════════════════════════════════════════════════════════

# ── Groq AI ────────────────────────────────────────────────────────
# Get from: https://console.groq.com/keys
GROQ_API_KEY=

# ── Supabase ───────────────────────────────────────────────────────
# SUPABASE_URL
#   Format : https://<project-ref>.supabase.co
#   Find at : Supabase Dashboard → Settings → API → Project URL
#   ✗ WRONG : https://xyz.supabase.co/rest/v1/   (no /rest/v1/ suffix)
#   ✓ RIGHT : https://xyz.supabase.co
SUPABASE_URL=

# SUPABASE_KEY
#   Use the "anon" public key OR the "service_role" secret key.
#   Find at : Supabase Dashboard → Settings → API → Project API keys
#   ✗ WRONG : sb_publishable_...  (this is a restricted publishable key)
#   ✓ RIGHT : eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...  (JWT format)
#
#   anon key       → safe for client use, subject to Row Level Security
#   service_role   → bypasses RLS, use only on server-side (never expose to browser)
#
#   For this app (server-side only Flask backend), either key works.
#   The service_role key is recommended so uploads/inserts work without
#   configuring RLS policies.
SUPABASE_KEY=

# ── Flask ──────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# ── Runtime ────────────────────────────────────────────────────────
FLASK_ENV=development
# FLASK_ENV=production   ← set this on Vercel

# Temp directory for in-process file handling
# Vercel sets this to /tmp automatically
# TMP_DIR=/tmp

# ══════════════════════════════════════════════════════════════════
# Required Supabase setup (one-time)
# ══════════════════════════════════════════════════════════════════
#
# 1. Run supabase_schema.sql in your Supabase SQL Editor
#
# 2. Create these Storage buckets in Supabase Dashboard → Storage:
#      original-files   (Public)
#      cleaned-files    (Public)
#      agent-files      (Public)
#
# 3. If using the anon key, add RLS policies to allow INSERT on:
#      datasets, dataset_versions, dataset_files, cleaning_operations,
#      agent_actions, insights, reports
#    OR use the service_role key to bypass RLS entirely.
#
# 4. Verify at: http://localhost:5000/api/health
# ══════════════════════════════════════════════════════════════════
